# Política de execução fora do sandbox — Valiant Group
#
# As regras abaixo usam a sintaxe Starlark oficial do Codex. Checks locais de
# build/teste permanecem dentro do sandbox e, portanto, não precisam de uma
# permissão ampla para escapar dele.

# Git bruto é autorizado para o fluxo normal, inclusive fetch/push/merge. A
# decisão mais restritiva prevalece, portanto os bloqueios abaixo continuam
# vencendo o `allow` geral em reescrita, destruição e bypass de hooks/root.
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], ["rebase", "reset", "clean"]], decision = "forbidden", justification = "Reescrita ou destruição de histórico não faz parte da entrega autônoma.")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], ["-c", "--git-dir", "--work-tree", "--config-env", "--bare"]], decision = "forbidden", justification = "Modificadores capazes de contornar root, configuração ou hooks permanecem bloqueados.")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"]], decision = "allow", justification = "Git bruto autorizado para desenvolvimento e entrega normais.")

prefix_rule(pattern = ["npm", ["install", "add"]], decision = "forbidden")
prefix_rule(pattern = ["pnpm", ["install", "add", "update"]], decision = "forbidden")
prefix_rule(pattern = ["yarn", ["install", "add", "upgrade"]], decision = "forbidden")
prefix_rule(pattern = ["bun", ["install", "add", "update"]], decision = "forbidden")
prefix_rule(pattern = [["pip", "pip3"], "install"], decision = "forbidden")
prefix_rule(pattern = [["python", "python3", "py"], "-m", "pip", "install"], decision = "forbidden")
prefix_rule(pattern = ["poetry", "add"], decision = "forbidden")
prefix_rule(pattern = ["uv", "add"], decision = "forbidden")
prefix_rule(pattern = ["cargo", "add"], decision = "forbidden")
prefix_rule(pattern = ["go", "get"], decision = "forbidden")
prefix_rule(pattern = ["composer", "require"], decision = "forbidden")
prefix_rule(pattern = ["dotnet", "add", "package"], decision = "forbidden")

prefix_rule(pattern = [["docker", "podman"], ["build", "run", "push"]], decision = "forbidden")
prefix_rule(pattern = ["docker", "compose", "up"], decision = "forbidden")
prefix_rule(pattern = ["docker-compose", "up"], decision = "forbidden")
prefix_rule(pattern = ["terraform", ["init", "plan"]], decision = "forbidden")

# Destruição local, alteração de histórico e elevação de privilégio.
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "restore"], decision = "forbidden", justification = "Não descarte alterações locais; aplique um patch reversível ao alvo explícito.")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "checkout", "--"], decision = "forbidden", justification = "Use git switch para branches e não descarte arquivos com checkout.")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "switch", ["-C", "--force-create", "-f", "--force", "--discard-changes"]], decision = "forbidden")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "branch", "-D"], decision = "forbidden")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "commit", ["--amend", "--no-verify", "-n"]], decision = "forbidden", justification = "Crie um novo commit convencional; não reescreva nem contorne hooks.")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "push", ["--force", "--force-with-lease", "-f", "--delete"]], decision = "forbidden", justification = "Force-push, exclusão remota e reescrita de refs são proibidos.")
prefix_rule(pattern = [["git", "git.exe", "/usr/bin/git", "/usr/local/bin/git", "/opt/homebrew/bin/git", "C:/Program Files/Git/cmd/git.exe", "C:/Program Files/Git/bin/git.exe"], "push", ["--no-verify", "-n"]], decision = "forbidden", justification = "O hook pre-push é obrigatório e não pode ser contornado.")
prefix_rule(pattern = ["rm", ["-rf", "-fr"]], decision = "forbidden", justification = "Use uma operação recuperável e um alvo explícito.")
prefix_rule(pattern = ["rm", ["-r", "-R", "--recursive"]], decision = "forbidden", justification = "Use uma operação recuperável e um alvo explícito.")
prefix_rule(pattern = ["rm", "-f", ["-r", "-R", "--recursive"]], decision = "forbidden", justification = "Use uma operação recuperável e um alvo explícito.")
prefix_rule(pattern = [["sudo", "su"]], decision = "forbidden", justification = "Execute sem elevação ou peça intervenção humana.")
prefix_rule(pattern = ["chmod", "-R", "777"], decision = "forbidden")
prefix_rule(pattern = [["rmdir", "rd"], "/s", "/q"], decision = "forbidden")
prefix_rule(pattern = ["del", "/f", "/s", "/q"], decision = "forbidden")
prefix_rule(pattern = [["powershell", "pwsh"], "Remove-Item", "-Recurse", "-Force"], decision = "forbidden")
prefix_rule(pattern = ["Remove-Item", "-Recurse", "-Force"], decision = "forbidden")
prefix_rule(pattern = [["format", "diskpart"]], decision = "forbidden")
prefix_rule(pattern = ["reg", "delete"], decision = "forbidden")

# Segredos e credenciais nunca devem ser enumerados fora do sandbox.
prefix_rule(pattern = [["printenv", "env"]], decision = "forbidden")
prefix_rule(pattern = ["cat", [".env", ".env.local", ".env.production"]], decision = "forbidden")
prefix_rule(pattern = ["type", [".env", ".env.local", ".env.production"]], decision = "forbidden")
prefix_rule(pattern = ["security", "find-generic-password"], decision = "forbidden")

# Produção e infraestrutura: bloqueio deliberado no kit de desenvolvimento.
prefix_rule(pattern = ["terraform", ["apply", "destroy"]], decision = "forbidden")
prefix_rule(pattern = ["kubectl", ["apply", "delete"]], decision = "forbidden")
prefix_rule(pattern = ["aws", ["iam", "secretsmanager"]], decision = "forbidden")
prefix_rule(pattern = ["gcloud", ["secrets", "sql"]], decision = "forbidden")
prefix_rule(pattern = ["flyctl", "deploy"], decision = "forbidden")
prefix_rule(pattern = ["vercel", "--prod"], decision = "forbidden")
prefix_rule(pattern = ["wrangler", "deploy"], decision = "forbidden")
